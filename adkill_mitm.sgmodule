#!name=adkill MITM除外
#!desc=MITM除外ホストの追記。conf本体(とca-p12)を触らずに除外を管理する。除外の追加・削除はこのファイルをGitHubで編集し、Shadowrocketでモジュールを更新するだけ。
#!category=AdBlock

[MITM]
# newsdig.tbs.co.jp の除外は 2026-09-09 に解除: ECH は誤診 (HTTPS RR なしを実測)。
# MITM+JS 注入で Admiral 壁を不発化する (adkill.js A2)。TLS エラーが再発したら
# -newsdig.tbs.co.jp をこの行に戻すこと
hostname = %APPEND% -*.twitter.com, -*.x.com, -*.twimg.com, -*.t.co, -*.periscope.tv
