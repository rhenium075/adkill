#!name=adkill MITM除外
#!desc=審査済みMITM対象・本文処理・固定SHAの実行コードを管理。更新・復旧はdocs/shadowrocket_update.mdを参照。
#!category=AdBlock
# Project-authored portions: GPL-3.0-or-later; upstream portions retain their terms.
# License text: https://raw.githubusercontent.com/rhenium075/adkill/main/LICENSE
# Source and notices: https://github.com/rhenium075/adkill/blob/main/THIRD_PARTY_NOTICES.md
# Distributed WITHOUT ANY WARRANTY. Preserve license and upstream notices.

[MITM]
# newsdig: MITM 除外を維持 (2026-09-10 確定)。SR ログ解析の結果、TLS は成功するが
# HTTP/1.1 + Connection: close + requires-body の組合せで応答が返らずリトライループに
# なるため、newsdig 本体は復号しない。壁は下の [URL Rewrite] のスタブ方式で止める
# 正の項目 = 復号対象の追加 (conf の許可リストに合流する。conf を触らずに済む)
# taxel/im-apps/rise.enhance = trafficnews で実測した広告 (TINYGIF 偽装のため復号)
# nicelyfrom/d3athhgvypbrtj.cloudfront = Ad-Shield sdk.js 配信ドメイン (スタブ差し替えのため復号)
# trafficnews.jp = Ad-Shield の壁サイト本体。MITM+adkill.js 注入で sdk.js の <script> タグと
#   独立復旧スクリプトを HTML から除去して壁を消す。keep-alive を観測したが、実機での継続動作を保証するものではない
#   (newsdig/livedoor は Connection:close のため除外側に置く)。
#   追加は tools/mitm_policy.json と docs/adversarial-hardening.md の実機確認条件に従う
hostname = %APPEND% trafficnews.jp, taxel.jp, *.taxel.jp, *.im-apps.net, rise.enhance.co.jp, nicelyfrom.com, *.nicelyfrom.com, d3athhgvypbrtj.cloudfront.net, -newsdig.tbs.co.jp, -*.twitter.com, -*.x.com, -*.twimg.com, -*.t.co, -*.periscope.tv

[Script]
# ==== 更新経路の固定 ====
# 実行コード (adkill.js / adshield_stub.js) は「検証済みコミットの完全 SHA」に固定する。
# main を自動追従させないことで、誤 push や侵害後のコードが既存端末で自動実行される
# 経路を塞ぐ (参照先の固定であり、本文の暗号学的検証ではない)。
# コード更新の運用: main で修正 → テスト合格 → python tools/pin_release.py <新SHA> →
# commit & push → ユーザーがモジュール更新で「この版を採用」。ロールバックは旧 SHA を指定。
# 本文バッファ対象は MITM 許可とは別に限定する。広告ホスト/API/拡張子なし画像には適用しない。
# 診断ホストのルート + trafficnews の公開トップ/記事/カテゴリだけを許可。
# 同じ URL が別形式を返す場合は依然実機確認が必要。tools/mitm_policy.json と対で更新する。
adkill = type=http-response, pattern=^(?:https://(?:example\.com|example\.org|neverssl\.com|httpforever\.com)/?|http://neverssl\.com/?|https://trafficnews\.jp/(?:post/[0-9]+(?:/[0-9]+)?/?|category/[a-z-]+/?)?)(?:[?#].*)?$, requires-body=1, max-size=3145728, timeout=30, script-path=https://raw.githubusercontent.com/rhenium075/adkill/93e8bc2117491423f8577b9069676a3319f657e5/adkill.js, script-update-interval=86400

[URL Rewrite]
# Ad-Shield の loader.min.js を「ゲートフラグを立てるだけの無害スタブ」に差し替える。
# ページ内の復旧スクリプトは loader 実行済みフラグを見て即 return するため、
# MITM 不可のサイト (newsdig 等) でも壁・CSS破壊・confirm ループが不発になる。
# loader の配信元 (html-load.com 等) は MITM 可能なのでこのリライトが効く。
# ※ adkill_custom.list 側で loader.min.js のパスだけ遮断除外している (対で保守)
^https?:\/\/(fb\.)?(html-load|content-loader)\.com\/loader\.min\.js https://cdn.jsdelivr.net/gh/rhenium075/adkill@93e8bc2117491423f8577b9069676a3319f657e5/adshield_stub.js 302
# sdk.js 系 (trafficnews 等の onload アンチタンパー型)。
# MITM 可能サイトでは adkill.js が sdk.js の <script> タグ(onload 込み)と独立復旧スクリプトを
# HTML から除去するため、通常 sdk.js はリクエストされない。ここは保険 (万一読まれた場合に
# ゲートフラグを立てて壁を抑止)。※ onload が残っている状態では偽物検知で白画面になりうるが、
# その状態は注入除去が効いていない = MITM 不成立時なので、いずれにせよ壁は避けられない
^https?:\/\/(fb\.)?(html-load|content-loader)\.com\/sdk\.js https://cdn.jsdelivr.net/gh/rhenium075/adkill@93e8bc2117491423f8577b9069676a3319f657e5/adshield_stub.js 302
^https?:\/\/([a-z0-9-]+\.)?nicelyfrom\.com\/sdk\.js https://cdn.jsdelivr.net/gh/rhenium075/adkill@93e8bc2117491423f8577b9069676a3319f657e5/adshield_stub.js 302
^https?:\/\/d3athhgvypbrtj\.cloudfront\.net\/sdk\.js https://cdn.jsdelivr.net/gh/rhenium075/adkill@93e8bc2117491423f8577b9069676a3319f657e5/adshield_stub.js 302
