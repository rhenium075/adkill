#!name=adkill MITM除外
#!desc=MITM除外ホストの追記。conf本体(とca-p12)を触らずに除外を管理する。除外の追加・削除はこのファイルをGitHubで編集し、Shadowrocketでモジュールを更新するだけ。
#!category=AdBlock

[MITM]
# newsdig: MITM 除外を維持 (2026-09-10 確定)。SR ログ解析の結果、TLS は成功するが
# HTTP/1.1 + Connection: close + requires-body の組合せで応答が返らずリトライループに
# なるため、newsdig 本体は復号しない。壁は下の [URL Rewrite] のスタブ方式で止める
# 正の項目 = 復号対象の追加 (conf の許可リストに合流する。conf を触らずに済む)
# taxel/im-apps/rise.enhance = trafficnews で実測した広告 (TINYGIF 偽装のため復号)
# nicelyfrom/d3athhgvypbrtj.cloudfront = Ad-Shield sdk.js 配信ドメイン (スタブ差し替えのため復号)
# trafficnews.jp = Ad-Shield の壁サイト本体。MITM+adkill.js 注入で sdk.js の <script> タグと
#   独立復旧スクリプトを HTML から除去して壁を消す。keep-alive のため MITM で接続死しない
#   (newsdig/livedoor は Connection:close のため除外側に置く)。
#   → 壁が出る新サイトを見つけたら、まず応答が keep-alive か確認し、そうならここに正の項目で追加
# 2026-09-10 第8報: よく訪れるサイトの「昇格」運用を開始。昇格条件 (docs 参照):
#   keep-alive / 施行 CSP なし / UTF-8 / WS・SSE なし / 注入ありエミュレーションで素の状態と同水準。
#   合格: jetstream.blog, rocketnews24.com, weathernews.jp, publickey1.jp, b.hatena.ne.jp
#   不合格: toyokeizai (Connection:close), itmedia・kakaku (Shift_JIS — SR のバッファは
#   非 UTF-8 を破壊しうるため昇格禁止), ameblo・note・gigazine (施行 CSP のため注入不能)
hostname = %APPEND% jetstream.blog, *.jetstream.blog, rocketnews24.com, *.rocketnews24.com, weathernews.jp, *.weathernews.jp, publickey1.jp, *.publickey1.jp, b.hatena.ne.jp, *.b.hatena.ne.jp, trafficnews.jp, *.trafficnews.jp, taxel.jp, *.taxel.jp, *.im-apps.net, rise.enhance.co.jp, nicelyfrom.com, *.nicelyfrom.com, d3athhgvypbrtj.cloudfront.net, -newsdig.tbs.co.jp, -*.twitter.com, -*.x.com, -*.twimg.com, -*.t.co, -*.periscope.tv

[Script]
# ==== 更新経路の固定 ====
# 実行コード (adkill.js / adshield_stub.js) は「検証済みコミットの完全 SHA」に固定する。
# main を自動追従させないことで、誤 push や侵害後のコードが既存端末で自動実行される
# 経路を塞ぐ (参照先の固定であり、本文の暗号学的検証ではない)。
# コード更新の運用: main で修正 → テスト合格 → python tools/pin_release.py <新SHA> →
# commit & push → ユーザーがモジュール更新で「この版を採用」。ロールバックは旧 SHA を指定。
# pattern はホストも許可リストにスコープする (2026-09-10 第7報)。
# 理由: 平文 HTTP のサイトは MITM 許可リストと無関係に requires-body が適用されるため、
# 旧 pattern (全ホストの文書 URL) では http://blog.livedoor.jp/... のような HTTP サイトが
# バッファリングに巻き込まれ応答死する (実機ログで確認)。
# 注入対象ホスト = バッジ検証用 + 壁対策サイト。壁サイトを増やすときは
# 上の hostname (%APPEND%) と、この pattern のホスト列挙の**両方**に追加すること (対で保守)
# ※ httpforever.com はバッジ検証から除外 (監査 F1: 同サイトは施行 CSP を返すため、
#   R02 の CSP 保持ガードにより注入されず、バッジ診断として自己矛盾する。
#   バッジ検証は example.com/org (HTTPS) と neverssl.com (平文 HTTP) を使う — 両方 CSP なし実測済)
adkill = type=http-response, pattern=^https?:\/\/([a-z0-9-]+\.)*(example\.(com|org)|neverssl\.com|trafficnews\.jp|jetstream\.blog|rocketnews24\.com|weathernews\.jp|publickey1\.jp|b\.hatena\.ne\.jp)(:\d+)?(?:\/(?:[^?#]*\/)?(?:[^.\/?#]*|[^\/?#]+\.(?:html?|php|aspx?|jsp)))?(?:[?#].*)?$, requires-body=1, max-size=3145728, timeout=30, script-path=https://raw.githubusercontent.com/rhenium075/adkill/8ab78744ac2c4060cea66dac5fa483ed82cd2316/adkill.js, script-update-interval=86400

[URL Rewrite]
# Ad-Shield の loader.min.js を「ゲートフラグを立てるだけの無害スタブ」に差し替える。
# ページ内の復旧スクリプトは loader 実行済みフラグを見て即 return するため、
# MITM 不可のサイト (newsdig 等) でも壁・CSS破壊・confirm ループが不発になる。
# loader の配信元 (html-load.com 等) は MITM 可能なのでこのリライトが効く。
# ※ adkill_custom.list 側で loader.min.js のパスだけ遮断除外している (対で保守)
^https?:\/\/(fb\.)?(html-load|content-loader)\.com\/loader\.min\.js https://cdn.jsdelivr.net/gh/rhenium075/adkill@8ab78744ac2c4060cea66dac5fa483ed82cd2316/adshield_stub.js 302
# sdk.js 系 (trafficnews 等の onload アンチタンパー型)。
# MITM 可能サイトでは adkill.js が sdk.js の <script> タグ(onload 込み)と独立復旧スクリプトを
# HTML から除去するため、通常 sdk.js はリクエストされない。ここは保険 (万一読まれた場合に
# ゲートフラグを立てて壁を抑止)。※ onload が残っている状態では偽物検知で白画面になりうるが、
# その状態は注入除去が効いていない = MITM 不成立時なので、いずれにせよ壁は避けられない
^https?:\/\/(fb\.)?(html-load|content-loader)\.com\/sdk\.js https://cdn.jsdelivr.net/gh/rhenium075/adkill@8ab78744ac2c4060cea66dac5fa483ed82cd2316/adshield_stub.js 302
^https?:\/\/([a-z0-9-]+\.)?nicelyfrom\.com\/sdk\.js https://cdn.jsdelivr.net/gh/rhenium075/adkill@8ab78744ac2c4060cea66dac5fa483ed82cd2316/adshield_stub.js 302
^https?:\/\/d3athhgvypbrtj\.cloudfront\.net\/sdk\.js https://cdn.jsdelivr.net/gh/rhenium075/adkill@8ab78744ac2c4060cea66dac5fa483ed82cd2316/adshield_stub.js 302
