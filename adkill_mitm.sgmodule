#!name=adkill MITM除外
#!desc=MITM除外ホストの追記。conf本体(とca-p12)を触らずに除外を管理する。除外の追加・削除はこのファイルをGitHubで編集し、Shadowrocketでモジュールを更新するだけ。
#!category=AdBlock

[MITM]
# newsdig: 2026-09-10 に除外へ復帰。除外解除の実機テストで「接続不可」を再現。
# ECH ではない (HTTPS RR なし・TLS はごく普通、を実測)。エミュレータでは MITM+注入で
# 壁なしの完全動作を確認済みのため、SR の MITM が newsdig で失敗する真因は端末側
# (ca-p12 消失 or SR の TLS 実装) とみられ、SR ログでの切り分け待ち。
# 切り分け: example.com バッジ → 出る なら newsdig 固有 / 出ない なら CA 再生成
hostname = %APPEND% -newsdig.tbs.co.jp, -*.twitter.com, -*.x.com, -*.twimg.com, -*.t.co, -*.periscope.tv
