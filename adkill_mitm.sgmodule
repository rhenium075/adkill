[Script]
# ==== 更新経路の固定 ====
# 実行コード (adkill.js / adshield_stub.js) は「検証済みコミットの完全 SHA」に固定する。
# main を自動追従させないことで、誤 push や侵害後のコードが既存端末で自動実行される
# 経路を塞ぐ (参照先の固定であり、本文の暗号学的検証ではない)。
# コード更新の運用: main で修正 → テスト合格 → python tools/pin_release.py <新SHA> →
# commit & push → ユーザーがモジュール更新で「この版を採用」。ロールバックは旧 SHA を指定。
# pattern は広域 (第9報)。ただし実測で壊れると確定したクラスをホスト除外する:
#   Connection:close (応答死): newsdig / blog.livedoor.jp・.com / fnn.jp / toyokeizai.net
#   Shift_JIS (SR のバッファが非 UTF-8 を破壊しうる): itmedia / kakaku / 5ch / 2chan
#   SPA ロード順に敏感 (エミュレータで崩れ・実機切り分け未了のため安全側で除外): nicovideo
# さらに /api/・/graphql/ パスは SSE・ストリーミングを巻き込まないよう除外。
# 新たに白画面・文字化け・アプリ不調が出たサイトは、この除外に追加して対処する。
# バッジ検証は example.com/org (HTTPS) と neverssl.com (平文 HTTP)。httpforever.com は
# 施行 CSP のためバッジが出ない (正常動作、監査 F1)
adkill = type=http-response, pattern=^https?:\/\/(?!([a-z0-9-]+\.)*(newsdig\.tbs\.co\.jp|blog\.livedoor\.(jp|com)|fnn\.jp|toyokeizai\.net|itmedia\.co\.jp|kakaku\.com|5ch\.net|2chan\.net|nicovideo\.jp)([\/:?#]|$))[^\/?#]+(:\d+)?(?![^?#]*\/(api|graphql)([\/?#]|$))(?:\/(?:[^?#]*\/)?(?:[^.\/?#]*|[^\/?#]+\.(?:html?|php|aspx?|jsp)))?(?:[?#].*)?$, requires-body=1, max-size=3145728, timeout=30, script-path=https://raw.githubusercontent.com/rhenium075/adkill/8ab78744ac2c4060cea66dac5fa483ed82cd2316/adkill.js, script-update-interval=86400

[URL Rewrite]
# Ad-Shield の loader.min.js を「ゲートフラグを立てるだけの無害スタブ」に差し替える。
# ページ内の復旧スクリプトは loader 実行済みフラグを見て即 return するため、
# MITM 不可のサイト (newsdig 等) でも壁・CSS破壊・confirm ループが不発になる。
# loader の配信元 (html-load.com 等) は MITM 可能なのでこのリライトが効く。
# ※ adkill_custom.list 側で loader.min.js のパスだけ遮断除外している (対で保守)
^https?:\/\/(fb\.)?(html-load|content-loader)\.com\/loader\.min\.js https://cdn.jsdelivr.net/gh/rhenium075/adkill@8ab78744ac2c4060cea66dac5fa483ed82cd2316/adshield_stub.js 302
# sdk.js 系 (trafficnews 等の onload アンチタンパー型)。
# MITM 可能サイトでは adkill.js が sdk.js の <script> タグ(onload 込み)と独立復旧スクリプトを
# HTML から除去するため、通常 sdk.js はリクエストされない。ここは保険 (万一読まれた場合に
# ゲートフラグを立てて壁を抑止)。※ onload が残っている状態では偽物検知で白画面になりうるが、
# その状態は注入除去が効いていない = MITM 不成立時なので、いずれにせよ壁は避けられない
^https?:\/\/(fb\.)?(html-load|content-loader)\.com\/sdk\.js https://cdn.jsdelivr.net/gh/rhenium075/adkill@8ab78744ac2c4060cea66dac5fa483ed82cd2316/adshield_stub.js 302
^https?:\/\/([a-z0-9-]+\.)?nicelyfrom\.com\/sdk\.js https://cdn.jsdelivr.net/gh/rhenium075/adkill@8ab78744ac2c4060cea66dac5fa483ed82cd2316/adshield_stub.js 302
^https?:\/\/d3athhgvypbrtj\.cloudfront\.net\/sdk\.js https://cdn.jsdelivr.net/gh/rhenium075/adkill@8ab78744ac2c4060cea66dac5fa483ed82cd2316/adshield_stub.js 302
