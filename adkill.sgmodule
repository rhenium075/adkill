#!name=AdKill — 全サイト広告・アンチアドブロック除去
#!desc=広告ホストは REJECT-TINYGIF で「成功したふり」、全 HTML に adkill.js を注入
#!category=AdBlock
# script-path は rhenium075/adkill を指す

[Rule]
# --- Google 広告系（遮断ではなく 200 + 1x1 GIF を返し、読み込み失敗検知を回避） ---
DOMAIN-SUFFIX,googlesyndication.com,REJECT-TINYGIF
DOMAIN-SUFFIX,doubleclick.net,REJECT-TINYGIF
DOMAIN-SUFFIX,googleadservices.com,REJECT-TINYGIF
DOMAIN-SUFFIX,googletagservices.com,REJECT-TINYGIF
DOMAIN-SUFFIX,adservice.google.com,REJECT-TINYGIF
DOMAIN-SUFFIX,adservice.google.co.jp,REJECT-TINYGIF
DOMAIN-SUFFIX,googletagmanager.com,REJECT-TINYGIF
DOMAIN-SUFFIX,google-analytics.com,REJECT-TINYGIF
DOMAIN-SUFFIX,fundingchoicesmessages.google.com,REJECT-TINYGIF
DOMAIN-SUFFIX,admob.com,REJECT-TINYGIF

# --- 海外主要 SSP/DSP/計測 ---
DOMAIN-SUFFIX,adnxs.com,REJECT-TINYGIF
DOMAIN-SUFFIX,adsrvr.org,REJECT-TINYGIF
DOMAIN-SUFFIX,criteo.com,REJECT-TINYGIF
DOMAIN-SUFFIX,criteo.net,REJECT-TINYGIF
DOMAIN-SUFFIX,rubiconproject.com,REJECT-TINYGIF
DOMAIN-SUFFIX,pubmatic.com,REJECT-TINYGIF
DOMAIN-SUFFIX,openx.net,REJECT-TINYGIF
DOMAIN-SUFFIX,casalemedia.com,REJECT-TINYGIF
DOMAIN-SUFFIX,smartadserver.com,REJECT-TINYGIF
DOMAIN-SUFFIX,taboola.com,REJECT-TINYGIF
DOMAIN-SUFFIX,outbrain.com,REJECT-TINYGIF
DOMAIN-SUFFIX,amazon-adsystem.com,REJECT-TINYGIF
DOMAIN-SUFFIX,moatads.com,REJECT-TINYGIF
DOMAIN-SUFFIX,scorecardresearch.com,REJECT-TINYGIF
DOMAIN-SUFFIX,doubleverify.com,REJECT-TINYGIF
DOMAIN-SUFFIX,adsafeprotected.com,REJECT-TINYGIF
DOMAIN-SUFFIX,applovin.com,REJECT-TINYGIF
DOMAIN-SUFFIX,unityads.unity3d.com,REJECT-TINYGIF
DOMAIN-SUFFIX,adcolony.com,REJECT-TINYGIF
DOMAIN-SUFFIX,teads.tv,REJECT-TINYGIF
DOMAIN-SUFFIX,yieldmo.com,REJECT-TINYGIF
DOMAIN-SUFFIX,sharethrough.com,REJECT-TINYGIF
DOMAIN-SUFFIX,33across.com,REJECT-TINYGIF
DOMAIN-SUFFIX,indexww.com,REJECT-TINYGIF
DOMAIN-SUFFIX,bidswitch.net,REJECT-TINYGIF
DOMAIN-SUFFIX,mgid.com,REJECT-TINYGIF

# --- 日本のアドネットワーク ---
DOMAIN-SUFFIX,popin.cc,REJECT-TINYGIF
DOMAIN-SUFFIX,gmossp-sp.jp,REJECT-TINYGIF
DOMAIN-SUFFIX,i-mobile.co.jp,REJECT-TINYGIF
DOMAIN-SUFFIX,adingo.jp,REJECT-TINYGIF
DOMAIN-SUFFIX,fluct.jp,REJECT-TINYGIF
DOMAIN-SUFFIX,socdm.com,REJECT-TINYGIF
DOMAIN-SUFFIX,adtdp.com,REJECT-TINYGIF
DOMAIN-SUFFIX,nend.net,REJECT-TINYGIF
DOMAIN-SUFFIX,amoad.com,REJECT-TINYGIF
DOMAIN-SUFFIX,microad.jp,REJECT-TINYGIF
DOMAIN-SUFFIX,microad.net,REJECT-TINYGIF
DOMAIN-SUFFIX,impact-ad.jp,REJECT-TINYGIF
DOMAIN-SUFFIX,logly.co.jp,REJECT-TINYGIF
DOMAIN-SUFFIX,ladsp.com,REJECT-TINYGIF
DOMAIN-SUFFIX,zucks.net,REJECT-TINYGIF
DOMAIN-SUFFIX,gssp.asia,REJECT-TINYGIF
DOMAIN-SUFFIX,adsta.jp,REJECT-TINYGIF
DOMAIN-SUFFIX,ad-stir.com,REJECT-TINYGIF
DOMAIN-SUFFIX,uncn.jp,REJECT-TINYGIF
DOMAIN-SUFFIX,yads.yahoo.co.jp,REJECT-TINYGIF
DOMAIN-SUFFIX,yads.c.yimg.jp,REJECT-TINYGIF

# --- アンチアドブロック用スクリプトのファイル名パターン ---
URL-REGEX,^https?://[^/]+/.*(adsbygoogle|/gpt|prebid|apstag|blockadblock|fuckadblock|adblock[-_]?detect|detect[-_]?adblock|anti[-_]?adblock|adblockdetect|ads\.js)[^/]*\.js,REJECT-TINYGIF
URL-REGEX,^https?://[^/]+/.*(blockadblock|fuckadblock|adblock[-_]?detect|detect[-_]?adblock|anti[-_]?adblock)[^/]*,REJECT-TINYGIF

# --- 外部ルールセット（404 になったら各リポジトリで最新パスを確認） ---
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Advertising/Advertising.list,REJECT-TINYGIF
RULE-SET,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/BanAD.list,REJECT-TINYGIF
RULE-SET,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/BanProgramAD.list,REJECT-TINYGIF

[Script]
adkill = type=http-response, pattern=^https?://.+, requires-body=1, max-size=3145728, timeout=30, script-path=https://raw.githubusercontent.com/rhenium075/adkill/main/adkill.js, script-update-interval=86400

[MITM]
# 全ホストを復号し、証明書ピンニングで壊れる/触る必要のないものを "-" で除外
hostname = *, -*.apple.com, -*.icloud.com, -*.icloud-content.com, -*.mzstatic.com, -*.push.apple.com, -*.apple-cloudkit.com, -*.googleapis.com, -*.googlevideo.com, -*.gvt1.com, -*.gvt2.com, -*.gstatic.com, -*.line.me, -*.line-apps.com, -*.line.naver.jp, -*.line-scdn.net, -*.paypay.ne.jp, -*.paypay-corp.co.jp, -*.mufg.jp, -*.smbc.co.jp, -*.mizuhobank.co.jp, -*.rakuten-bank.co.jp, -*.jp-bank.japanpost.jp, -*.sbisec.co.jp, -*.docomo.ne.jp, -*.nttdocomo.co.jp, -*.au.com, -*.kddi.com, -*.softbank.jp, -*.nintendo.net, -*.nintendo.com, -*.playstation.com, -*.sony.com, -*.sonyentertainmentnetwork.com, -*.microsoft.com, -*.live.com, -*.windows.com, -*.office.com, -*.office365.com, -*.slack.com, -*.slack-edge.com, -*.whatsapp.net, -*.signal.org, -*.stripe.com, -*.myjcb.co.jp, -*.smbc-card.com, -*.rakuten-card.co.jp, -*.mercari.com, -*.mercari.jp
